        if (!activeIdentifiedTeacher) return;
        if (isSubmittingAttendance) return;

        var statusEl = document.getElementById('modalPresensiStatus');
        var isLate = statusEl && statusEl.textContent.indexOf('Terlambat') !== -1;
        var lateInput = document.getElementById('modalLateReasonInput');
        var reason = '-';

        if (isLate) {
          var val = (lateInput ? lateInput.value : '').trim();
          if (val.length < 5) {
            showToast('Alasan keterlambatan wajib diisi minimal 5 karakter!', 'warning');
            if (lateInput) lateInput.focus();
            return;
          }
          reason = val;
        }

        var isPasscode = activeIdentifiedTeacher._verificationMethod === 'Kode Kunci';
        var finalCatatan = (reason === '-' ? '' : reason) + (isPasscode ? ' [Verif: Kode Kunci]' : ' [Verif: Kamera]');
        var devId = getOrCreateDeviceId();

        var payload = {
          guruId: activeIdentifiedTeacher.id,
          nama: activeIdentifiedTeacher.nama,
