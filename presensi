      function calculateDistanceMeters(lat1, lon1, lat2, lon2) {
        var R = 6371000;
        var dLat = (lat2 - lat1) * Math.PI / 180;
        var dLon = (lon2 - lon1) * Math.PI / 180;
        var a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                Math.sin(dLon / 2) * Math.sin(dLon / 2);
        var c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
        return Math.round(R * c);
      }

      function refreshGeolocation(showNotification) {
        if (!navigator.geolocation) {
          fallbackGeolocation();
          return;
        }

        navigator.geolocation.getCurrentPosition(
          function (pos) {
            var lat = pos.coords.latitude;
            var lng = pos.coords.longitude;
            var dist = calculateDistanceMeters(lat, lng, appSettings.schoolLat, appSettings.schoolLng);
            var withinRange = !appSettings.enforceGeo || (dist <= appSettings.radiusMeters);

            userGeoCoord = { lat: lat, lng: lng, distance: dist, inRange: withinRange };
            updateGPSCardUI();
            if (showNotification) showToast('Lokasi GPS berhasil diperbarui. Jarak: ~' + dist + 'm', 'success');
          },
