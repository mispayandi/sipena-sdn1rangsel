      function generatePivotAttendanceTable() {
        var selBulan = parseInt(document.getElementById('pivotBulanSelect').value, 10);
        var selTahun = parseInt(document.getElementById('pivotTahunSelect').value, 10);

        var periodLabel = document.getElementById('pivotReportPeriodLabel');
        if (periodLabel) {
          periodLabel.textContent = MONTH_NAMES_ID[selBulan - 1].toUpperCase() + ' ' + selTahun;
        }

        var totalDays = getDaysInMonth(selTahun, selBulan);
        var headDays = document.getElementById('pivotHeadRowDays');
        var headSub = document.getElementById('pivotHeadRowSub');
        var tbody = document.getElementById('pivotMatrixTableBody');
        var emptyMsg = document.getElementById('pivotEmptyState');

        var sigTgl = document.getElementById('sigTanggalKepsekLabel');
        if (sigTgl) {
          sigTgl.textContent = 'Rarang Selatan, ' + totalDays + ' ' + MONTH_NAMES_ID[selBulan - 1] + ' ' + selTahun;
        }

        if (!headDays || !headSub || !tbody) return;

        var htmlHeadDays = '<th rowspan="2" class="border border-slate-300 px-1 py-1 min-w-[32px] w-8 bg-slate-100 text-slate-800">No</th>' +
                           '<th rowspan="2" class="border border-slate-300 px-3 py-1 text-left min-w-[170px] bg-slate-100 text-slate-800">Nama Guru</th>';
        var htmlHeadSub = '';

        for (var d = 1; d <= totalDays; d++) {
          var dateObj = new Date(selTahun, selBulan - 1, d);
          var isSunday = (dateObj.getDay() === 0);
          var thClass = isSunday ? 'border border-slate-300 px-1 py-0.5 bg-rose-100 text-rose-700 font-black' : 'border border-slate-300 px-1 py-0.5 bg-slate-100 text-slate-800 font-bold';
          var subMClass = isSunday ? 'border border-slate-300 px-0.5 py-0.5 w-6 bg-rose-50 text-rose-700 font-bold' : 'border border-slate-300 px-0.5 py-0.5 w-6 text-slate-700 font-bold';
          var subPClass = isSunday ? 'border border-slate-300 px-0.5 py-0.5 w-6 bg-rose-50 text-rose-700 font-bold' : 'border border-slate-300 px-0.5 py-0.5 w-6 text-slate-700 font-bold';

          htmlHeadDays += '<th colspan="2" class="' + thClass + ' min-w-[50px]">' + d + '</th>';
          htmlHeadSub += '<th class="' + subMClass + '">M</th><th class="' + subPClass + '">P</th>';
        }

        htmlHeadDays += '<th colspan="3" class="border border-slate-300 px-2 py-0.5 bg-emerald-100 text-emerald-900 font-black">Total</th>';
        htmlHeadSub += '<th class="border border-slate-300 px-1.5 py-0.5 bg-emerald-50 text-emerald-800 font-black">H</th>' +
                       '<th class="border border-slate-300 px-1.5 py-0.5 bg-amber-50 text-amber-800 font-black">I</th>' +
                       '<th class="border border-slate-300 px-1.5 py-0.5 bg-rose-50 text-rose-800 font-black">A</th>';

        headDays.innerHTML = htmlHeadDays;
        headSub.innerHTML = htmlHeadSub;

        var attMatrix = {};
        attendanceLogs.forEach(function (log) {
          var rawDate = String(log.timestamp || '').slice(0, 10);
          var parts = rawDate.split('-');
          if (parts.length === 3) {
            var logYear = parseInt(parts[0], 10);
            var logMonth = parseInt(parts[1], 10);
            var logDay = parseInt(parts[2], 10);

            if (logYear === selTahun && logMonth === selBulan) {
              var teacherKey = (log.nama || '').trim().toLowerCase();
              var dayKey = teacherKey + '|' + logDay;

              if (!attMatrix[dayKey]) {
                attMatrix[dayKey] = { datang: '', pulang: '', status: log.status, catatan: log.catatan || '' };
              }

              var timeStr = '';
              if (log.timeWITA) {
                var tMatch = log.timeWITA.match(/(\d{1,2}:\d{2})/);
                timeStr = tMatch ? tMatch[1] : log.timeWITA.slice(0, 5);
              } else if (log.timestamp) {
                var tsMatch = log.timestamp.match(/(\d{1,2}:\d{2})/);
                timeStr = tsMatch ? tsMatch[1] : '';
              }

              if (log.tipe && log.tipe.toLowerCase() === 'datang') {
                attMatrix[dayKey].datang = timeStr;
                attMatrix[dayKey].status = log.status;
              } else if (log.tipe && log.tipe.toLowerCase() === 'pulang') {
                attMatrix[dayKey].pulang = timeStr;
              }
            }
          }
        });

        var masterTeachersMap = {};
        teachersList.forEach(function (t) {
          if (t.status === 'Disetujui') {
            masterTeachersMap[t.nama.trim().toLowerCase()] = t.nama;
          }
        });

        attendanceLogs.forEach(function (l) {
          if (l.nama) {
            var k = l.nama.trim().toLowerCase();
            if (!masterTeachersMap[k]) {
              masterTeachersMap[k] = l.nama;
            }
          }
        });

        var teacherNames = Object.keys(masterTeachersMap).map(function (k) {
          return masterTeachersMap[k];
        });

        teacherNames.sort(function (a, b) {
          return a.localeCompare(b);
        });

        if (teacherNames.length === 0) {
          tbody.innerHTML = '';
          if (emptyMsg) emptyMsg.classList.remove('d-none');
          return;
        }

        if (emptyMsg) emptyMsg.classList.add('d-none');

        var today = new Date();
        var currentY = today.getFullYear();
        var currentM = today.getMonth() + 1;
        var currentD = today.getDate();

        var htmlRows = '';
        teacherNames.forEach(function (namaGuru, idx) {
          var tKey = namaGuru.trim().toLowerCase();
          var totalHadir = 0;
          var totalIzin = 0;
          var totalAlpa = 0;

          var cellsHtml = '';

          for (var day = 1; day <= totalDays; day++) {
            var dateObj = new Date(selTahun, selBulan - 1, day);
            var isSunday = (dateObj.getDay() === 0);
            var cellKey = tKey + '|' + day;
            var record = attMatrix[cellKey];

            var dVal = '';
            var pVal = '';
            var bgCol = isSunday ? 'bg-rose-50/70 text-rose-700' : '';

            var isPastDay = false;
            if (selTahun < currentY) isPastDay = true;
            else if (selTahun === currentY && selBulan < currentM) isPastDay = true;
            else if (selTahun === currentY && selBulan === currentM && day <= currentD) isPastDay = true;

            if (record && (record.datang || record.pulang)) {
              dVal = record.datang || '✓';
              pVal = record.pulang || '-';
              totalHadir++;
            } else if (!isSunday && isPastDay) {
              dVal = 'A';
              pVal = 'A';
              totalAlpa++;
            }

            var dClass = 'border border-slate-300 font-mono text-[9px] ' + (dVal === 'A' ? 'text-rose-600 font-bold bg-rose-50' : bgCol);
            var pClass = 'border border-slate-300 font-mono text-[9px] ' + (pVal === 'A' ? 'text-rose-600 font-bold bg-rose-50' : bgCol);

            cellsHtml += '<td class="' + dClass + '">' + escapeHTML(dVal) + '</td>' +
                         '<td class="' + pClass + '">' + escapeHTML(pVal) + '</td>';
          }

          htmlRows += '<tr class="hover:bg-blue-50/30 transition">' +
            '<td class="border border-slate-300 py-1.5 px-1 font-bold text-slate-700 bg-slate-50">' + (idx + 1) + '</td>' +
            '<td class="border border-slate-300 py-1.5 px-3 text-left font-bold text-slate-900 uppercase whitespace-nowrap bg-white">' + escapeHTML(namaGuru) + '</td>' +
            cellsHtml +
            '<td class="border border-slate-300 py-1 px-1 font-bold text-emerald-800 bg-emerald-50/60 font-mono text-center">' + totalHadir + '</td>' +
            '<td class="border border-slate-300 py-1 px-1 font-bold text-amber-700 bg-amber-50/60 font-mono text-center">' + totalIzin + '</td>' +
            '<td class="border border-slate-300 py-1 px-1 font-bold text-rose-700 bg-rose-50/60 font-mono text-center">' + totalAlpa + '</td>' +
          '</tr>';
        });

        tbody.innerHTML = htmlRows;
        updatePrintKopAndSignaturesUI();
      }

