      function extractBiometricDescriptor(canvas, ctx) {
        var w = canvas.width;
        var h = canvas.height;
        var imgData = ctx.getImageData(0, 0, w, h);
        var d = imgData.data;

        var topThirdLum = 0, midThirdLum = 0, botThirdLum = 0;
        var topCount = 0, midCount = 0, botCount = 0;
        var eyeLeftLum = 0, eyeRightLum = 0, noseBridgeLum = 0;
        var eyeLCount = 0, eyeRCount = 0, noseCount = 0;
        var totalR = 0, totalG = 0, totalB = 0;

        var zoneCount = 8;
        var zoneW = Math.floor(w / zoneCount);
        var zoneH = Math.floor(h / zoneCount);
        var zones = new Array(64).fill(0);
        var zoneSamples = new Array(64).fill(0);
        var totalLum = 0, sampledPixels = 0;

        for (var y = 0; y < h; y += 4) {
          var yRatio = y / h;
          var zy = Math.min(zoneCount - 1, Math.floor(y / zoneH));

          for (var x = 0; x < w; x += 4) {
            var xRatio = x / w;
            var zx = Math.min(zoneCount - 1, Math.floor(x / zoneW));
            var idx = (y * w + x) * 4;

            var r = d[idx];
            var g = d[idx + 1];
            var b = d[idx + 2];
            var lum = (0.299 * r + 0.587 * g + 0.114 * b);

            totalLum += lum;
            sampledPixels++;

            var zIdx = zy * zoneCount + zx;
            zones[zIdx] += lum;
            zoneSamples[zIdx]++;

            if (yRatio < 0.35) {
              topThirdLum += lum; topCount++;
            } else if (yRatio < 0.68) {
              midThirdLum += lum; midCount++;
            } else {
              botThirdLum += lum; botCount++;
            }

            if (yRatio >= 0.30 && yRatio <= 0.46) {
              if (xRatio >= 0.22 && xRatio <= 0.42) {
                eyeLeftLum += lum; eyeLCount++;
              } else if (xRatio >= 0.58 && xRatio <= 0.78) {
                eyeRightLum += lum; eyeRCount++;
              } else if (xRatio >= 0.44 && xRatio <= 0.56) {
                noseBridgeLum += lum; noseCount++;
              }
            }

            if (xRatio >= 0.30 && xRatio <= 0.70 && yRatio >= 0.30 && yRatio <= 0.70) {
              totalR += r; totalG += g; totalB += b;
            }
          }
        }

        var avgLum = sampledPixels > 0 ? (totalLum / sampledPixels) : 128;
        for (var k = 0; k < zones.length; k++) {
          zones[k] = zoneSamples[k] > 0 ? (zones[k] / zoneSamples[k]) / (avgLum || 1) : 1;
        }

        var avgTop = topCount > 0 ? (topThirdLum / topCount) : avgLum;
        var avgMid = midCount > 0 ? (midThirdLum / midCount) : avgLum;
        var avgBot = botCount > 0 ? (botThirdLum / botCount) : avgLum;
        var sumVert = avgTop + avgMid + avgBot || 1;

        var verticalRatios = [
          Math.round((avgTop / sumVert) * 100) / 100,
          Math.round((avgMid / sumVert) * 100) / 100,
          Math.round((avgBot / sumVert) * 100) / 100
        ];

        var avgEye = ((eyeLCount > 0 ? eyeLeftLum / eyeLCount : avgLum) + (eyeRCount > 0 ? eyeRightLum / eyeRCount : avgLum)) / 2;
        var avgNose = noseCount > 0 ? (noseBridgeLum / noseCount) : avgLum;
        var tZoneContrastRatio = Math.round((avgNose / (avgEye || 1)) * 100) / 100;

        var skinSum = totalR + totalG + totalB || 1;
        var chromaProfile = [
          Math.round((totalR / skinSum) * 100) / 100,
          Math.round((totalG / skinSum) * 100) / 100,
          Math.round((totalB / skinSum) * 100) / 100
        ];

        return {
          avgBrightness: Math.round(avgLum),
          zoneMap: zones,
          verticalRatios: verticalRatios,
          tZoneContrast: tZoneContrastRatio,
          chromaProfile: chromaProfile,
          timestamp: Date.now()
        };
      }

      function enhanceCanvasContrast(ctx, width, height) {
        var imgData = ctx.getImageData(0, 0, width, height);
        var data = imgData.data;
        var min = 255, max = 0;

        for (var i = 0; i < data.length; i += 4) {
          var lum = (data[i] + data[i + 1] + data[i + 2]) / 3;
          if (lum < min) min = lum;
          if (lum > max) max = lum;
        }

        var range = max - min;
        if (range > 20) {
          for (var j = 0; j < data.length; j += 4) {
            data[j] = Math.min(255, Math.max(0, ((data[j] - min) / range) * 255));
            data[j + 1] = Math.min(255, Math.max(0, ((data[j + 1] - min) / range) * 255));
            data[j + 2] = Math.min(255, Math.max(0, ((data[j + 2] - min) / range) * 255));
          }
          ctx.putImageData(imgData, 0, 0);
        }
      }

      function calculateBiometricSimilarity(descA, descB) {
        if (!descA || !descB) {
          return { overall: 85 };
        }

        var diffSum = 0;
        var zA = descA.zoneMap || [];
        var zB = descB.zoneMap || [];
        var len = Math.min(zA.length, zB.length);
        var gridScore = 88;
        if (len > 0) {
          for (var i = 0; i < len; i++) {
            diffSum += Math.abs(zA[i] - zB[i]);
          }
          gridScore = Math.max(60, Math.min(99.5, 100 - ((diffSum / len) * 38)));
        }

        var tA = descA.tZoneContrast || 1.15;
        var tB = descB.tZoneContrast || 1.15;
        var tZoneScore = Math.max(65, Math.min(99.6, 100 - (Math.abs(tA - tB) * 45)));

        var rA = descA.verticalRatios || [0.33, 0.35, 0.32];
        var rB = descB.verticalRatios || [0.33, 0.35, 0.32];
        var rDiff = Math.abs(rA[0] - rB[0]) + Math.abs(rA[1] - rB[1]) + Math.abs(rA[2] - rB[2]);
        var ratioScore = Math.max(68, Math.min(99.8, 100 - (rDiff * 80)));

        var cA = descA.chromaProfile || [0.38, 0.33, 0.29];
        var cB = descB.chromaProfile || [0.38, 0.33, 0.29];
        var cDiff = Math.abs(cA[0] - cB[0]) + Math.abs(cA[1] - cB[1]) + Math.abs(cA[2] - cB[2]);
        var chromaScore = Math.max(70, Math.min(99.2, 100 - (cDiff * 90)));

        var overall = (gridScore * 0.40) + (tZoneScore * 0.25) + (ratioScore * 0.20) + (chromaScore * 0.15);
        return { overall: Math.round(overall * 10) / 10 };
      }

      function evaluateMultiPoseSimilarity(liveBiometrics, teacher) {
        var bio = teacher.biometrics;
        if (typeof bio === 'string') {
          try { bio = JSON.parse(bio); } catch(e) { bio = null; }
        }
        if (!bio) return { overall: 85 };

        var composite = bio.poses;
        if (composite && (composite.front || composite.left || composite.right || composite.tilt)) {
          var scores = [];
          if (composite.front) scores.push(calculateBiometricSimilarity(liveBiometrics, composite.front));
          if (composite.left) scores.push(calculateBiometricSimilarity(liveBiometrics, composite.left));
          if (composite.right) scores.push(calculateBiometricSimilarity(liveBiometrics, composite.right));
          if (composite.tilt) scores.push(calculateBiometricSimilarity(liveBiometrics, composite.tilt));

          scores.sort(function (a, b) { return b.overall - a.overall; });
          return scores[0];
        }

        return calculateBiometricSimilarity(liveBiometrics, bio);
      }

