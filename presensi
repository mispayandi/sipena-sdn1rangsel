      function renderTodayAttendanceTable() {
        var tbody = document.getElementById('todayAttendanceTableBody');
        var emptyMsg = document.getElementById('todayAttendanceEmptyMsg');
        var dateLabel = document.getElementById('rekapTodayDateLabel');
        if (!tbody) return;

        var todayStr = getTodayDateString();
        if (dateLabel) dateLabel.textContent = todayStr + ' WITA';

        var q = (document.getElementById('todaySearchInput') ? document.getElementById('todaySearchInput').value : '').toLowerCase();

        var todayMap = {};
        attendanceLogs.forEach(function (item) {
          var rowDate = String(item.timestamp || '').slice(0, 10);
          if (rowDate === todayStr) {
            var key = item.guruId || item.nama;
            if (!todayMap[key]) {
              todayMap[key] = {
                guruId: item.guruId,
                nama: item.nama,
                nip: item.nip,
                waktuDatang: '-',
                waktuPulang: '-',
                status: 'Tepat Waktu',
                catatan: '-'
              };
            }
            if (item.tipe && item.tipe.toLowerCase() === 'datang') {
              todayMap[key].waktuDatang = item.timeWITA || item.timestamp;
              todayMap[key].status = item.status;
              if (item.catatan && item.catatan !== '-') {
                todayMap[key].catatan = item.catatan;
              }
            } else if (item.tipe && item.tipe.toLowerCase() === 'pulang') {
              todayMap[key].waktuPulang = item.timeWITA || item.timestamp;
            }
          }
        });

        var list = Object.keys(todayMap).map(function (k) { return todayMap[k]; });

        var filtered = list.filter(function (entry) {
          return (entry.nama || '').toLowerCase().indexOf(q) !== -1 || (entry.nip || '').indexOf(q) !== -1;
        });

        if (filtered.length === 0) {
          tbody.innerHTML = '';
          if (emptyMsg) emptyMsg.classList.remove('d-none');
          return;
        }

