      function useCurrentLocationAsSchoolCenter() {
        if (!navigator.geolocation) {
          showToast('Perangkat tidak mendukung GPS.', 'error');
          return;
        }

        showFullPageLoading('Mendeteksi koordinat perangkat...');
        navigator.geolocation.getCurrentPosition(
          function (pos) {
            hideFullPageLoading();
            var latInput = document.getElementById('cfgGeoLat');
            var lngInput = document.getElementById('cfgGeoLng');
            if (latInput) latInput.value = pos.coords.latitude.toFixed(6);
            if (lngInput) lngInput.value = pos.coords.longitude.toFixed(6);
            showToast('Koordinat perangkat berhasil diisi ke form!', 'success');
          },
          function (err) {
            hideFullPageLoading();
            showToast('Gagal membaca GPS: ' + err.message, 'warning');
          },
          { enableHighAccuracy: true, timeout: 8000 }
        );
      }

      function exportAttendanceCSV() {
        if (!attendanceLogs || attendanceLogs.length === 0) {
          showToast('Belum ada data presensi untuk diekspor.', 'warning');
          return;
        }

        var csvRows = [];
        csvRows.push(['No', 'Nama Guru', 'NIP', 'Waktu Presensi (WITA)', 'Tipe', 'Status', 'Jarak (Meter)', 'Catatan'].join(','));

        attendanceLogs.forEach(function (log, index) {
          var row = [
            index + 1,
            '"' + (log.nama || '').replace(/"/g, '""') + '"',
            '"' + (log.nip || '').replace(/"/g, '""') + '"',
            '"' + (log.timeWITA || log.timestamp || '').replace(/"/g, '""') + '"',
            '"' + (log.tipe || '').replace(/"/g, '""') + '"',
            '"' + (log.status || '').replace(/"/g, '""') + '"',
            log.distanceMeter || 0,
            '"' + (log.catatan || '-').replace(/"/g, '""') + '"'
          ];
          csvRows.push(row.join(','));
        });

        var csvContent = '\uFEFF' + csvRows.join('\r\n');
        var blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        var url = URL.createObjectURL(blob);
        var link = document.createElement('a');
        link.href = url;
        link.download = 'Rekap_Presensi_SDN1_RarangSelatan_' + getTodayDateString() + '.csv';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(url);

        showToast('Data presensi berhasil diekspor ke CSV!', 'success');
      }

