      function triggerFaceCaptureAndMatch() {
        if (appSettings.terminalActive === false) {
          showErrorModal('Terminal Ditutup', 'Terminal absensi saat ini sedang dinonaktifkan oleh Administrator.');
          return;
        }

        if (appSettings.enforceGeo && !userGeoCoord.inRange) {
          showErrorModal('Lokasi Di Luar Jangkauan', 'Sistem mendeteksi posisi Anda berjarak ' + userGeoCoord.distance + ' meter. Maksimal radius yang diizinkan adalah ' + appSettings.radiusMeters + ' meter.');
          return;
        }

        var video = document.getElementById('webcamVideo');
        var canvas = document.getElementById('captureCanvas');

        if (!video || !video.videoWidth) {
          showErrorModal('Kamera Belum Siap', 'Pastikan kamera aktif dan berikan izin akses.');
          return;
        }

        canvas.width = 600;
        canvas.height = 600;
        var ctx = canvas.getContext('2d');

        var minSide = Math.min(video.videoWidth, video.videoHeight);
        var startX = (video.videoWidth - minSide) / 2;
        var startY = (video.videoHeight - minSide) / 2;
        ctx.drawImage(video, startX, startY, minSide, minSide, 0, 0, 600, 600);
        enhanceCanvasContrast(ctx, 600, 600);

        var liveBiometrics = extractBiometricDescriptor(canvas, ctx);

        if (liveBiometrics.avgBrightness < 35) {
          showErrorModal('Pencahayaan Terlalu Gelap', 'Intensitas cahaya kurang. Harap hadap ke arah cahaya atau ruangan yang lebih terang.');
          return;
        }

        showFullPageLoading('Mendeteksi ciri khusus wajah...');

        var approvedTeachers = teachersList.filter(function (t) {
          return t.status === 'Disetujui';
        });

        if (approvedTeachers.length === 0) {
          hideFullPageLoading();
          showErrorModal('Belum Ada Guru Terdaftar', 'Belum ada data guru berstatus Disetujui di sistem.');
          return;
        }

        setTimeout(function () {
          hideFullPageLoading();

          var bestCandidate = null;
          var highestScore = -1;

          approvedTeachers.forEach(function (teacher) {
            var simResult = evaluateMultiPoseSimilarity(liveBiometrics, teacher);
            if (simResult.overall > highestScore) {
              highestScore = simResult.overall;
              bestCandidate = teacher;
            }
          });

          if (!bestCandidate || highestScore < 65) {
            showErrorModal('Wajah Belum Cocok', 'Tingkat kecocokan biometrik sebesar ' + (highestScore > 0 ? highestScore : 60) + '%. Posisikan wajah di dalam oval hijau.');
            return;
          }

          var todayStr = getTodayDateString();
          var alreadyDone = attendanceLogs.some(function(item) {
            var itemDate = String(item.timestamp || '').slice(0, 10);
            var isSameTeacher = (item.guruId === bestCandidate.id) || 
                                (item.nama && item.nama.toLowerCase() === bestCandidate.nama.toLowerCase());
            return isSameTeacher && itemDate === todayStr && item.tipe.toLowerCase() === currentPresenceMode.toLowerCase();
          });

          if (alreadyDone) {
            showErrorModal('Presensi Sudah Ada', 'Guru ' + bestCandidate.nama + ' sudah melakukan presensi ' + currentPresenceMode + ' hari ini.');
            return;
          }

          bestCandidate._verificationMethod = 'Kamera';
          openVerificationModal(bestCandidate);
        }, 600);
      }

      function openVerificationModal(teacher) {
        activeIdentifiedTeacher = teacher;

        var modal = document.getElementById('modalVerification');
        var photo = document.getElementById('modalTeacherPhoto');
        var name = document.getElementById('modalTeacherName');
        var nip = document.getElementById('modalTeacherNIP');
        var role = document.getElementById('modalTeacherRole');
        var timeEl = document.getElementById('modalPresensiTime');
        var statusEl = document.getElementById('modalPresensiStatus');
        var statusBox = document.getElementById('modalStatusContainer');
        var lateBox = document.getElementById('modalLateReasonBox');
        var lateInput = document.getElementById('modalLateReasonInput');

        if (photo) photo.src = teacher.photo;
        if (name) name.textContent = teacher.nama;
        if (nip) nip.textContent = (teacher.nip ? 'NIP: ' + teacher.nip : 'NIP: -') + ' • Verifikasi: ' + (teacher._verificationMethod || 'Kamera');
        if (role) role.textContent = teacher.jabatan || 'Guru Pegawai';

        var now = new Date();
        var utc = now.getTime() + (now.getTimezoneOffset() * 60000);
        var witaNow = new Date(utc + (3600000 * 8));

        var currentHour = witaNow.getHours();
        var currentMinute = witaNow.getMinutes();
        var currentSecond = witaNow.getSeconds();
        var currentTotalMinutes = (currentHour * 60) + currentMinute;

        var parts = (appSettings.jamDatangToleransi || '07:15').split(':');
        var limitHour = parseInt(parts[0], 10) || 7;
        var limitMinute = parseInt(parts[1], 10) || 15;
        var limitTotalMinutes = (limitHour * 60) + limitMinute;

        var timeString = String(currentHour).padStart(2, '0') + ':' +
                         String(currentMinute).padStart(2, '0') + ':' +
                         String(currentSecond).padStart(2, '0') + ' WITA';

        if (timeEl) timeEl.textContent = timeString;

        var isLate = (currentPresenceMode === 'Datang') && (currentTotalMinutes > limitTotalMinutes);

        if (isLate) {
          if (statusEl) {
            statusEl.textContent = 'Terlambat (Lewat ' + (currentTotalMinutes - limitTotalMinutes) + ' Menit)';
            statusEl.className = 'font-bold text-xs text-rose-600';
          }
          if (statusBox) statusBox.className = 'p-3 rounded-xl border border-rose-200 bg-rose-50';
          if (lateBox) lateBox.classList.remove('d-none');
          if (lateInput) lateInput.value = '';
        } else {
          if (statusEl) {
            statusEl.textContent = currentPresenceMode === 'Datang' ? 'Tepat Waktu' : 'Presensi Kepulangan';
            statusEl.className = 'font-bold text-xs text-emerald-600';
          }
          if (statusBox) statusBox.className = 'p-3 rounded-xl border border-emerald-200 bg-emerald-50';
          if (lateBox) lateBox.classList.add('d-none');
        }

        if (modal) modal.classList.remove('d-none');
      }

