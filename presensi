      function renderAdminTeachersTable(teachers) {
        var tbody = document.getElementById('guruTableBody');
        var badgePending = document.getElementById('countPendingBadge');
        var totalGuruEl = document.getElementById('totalGuruCount');
        if (!tbody) return;

        var pendingCount = 0;
        var html = '';

        teachers.forEach(function (guru) {
          if (guru.status === 'Menunggu Persetujuan') {
            pendingCount++;
          }

          var statusBadge = '';
          if (guru.status === 'Disetujui') {
            statusBadge = '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">Disetujui</span>';
          } else if (guru.status === 'Ditolak') {
            statusBadge = '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800">Ditolak</span>';
          } else {
            statusBadge = '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">Menunggu</span>';
          }

          var photoSrc = guru.photo || 'https://placehold.co/80x80/e2e8f0/475569?text=Foto';
          var passcode = guru.kodeKunci || '-';

          html += '<tr class="hover:bg-slate-50 transition">' +
            '<td class="py-2.5 px-3">' +
              '<div class="w-10 h-10 rounded-xl overflow-hidden border border-slate-300 bg-slate-100">' +
                '<img src="' + photoSrc + '" alt="Foto" class="w-full h-full object-cover" onerror="this.src=\'https://placehold.co/80x80/e2e8f0/475569?text=Foto\'">' +
              '</div>' +
            '</td>' +
            '<td class="py-2.5 px-3">' +
              '<div class="font-bold text-slate-800">' + escapeHTML(guru.nama) + '</div>' +
              '<div class="font-mono text-[10px] text-slate-400">NIP: ' + escapeHTML(guru.nip || '-') + '</div>' +
            '</td>' +
            '<td class="py-2.5 px-3 text-slate-600">' + escapeHTML(guru.jabatan || 'Guru') + '</td>' +
            '<td class="py-2.5 px-3">' +
              '<div class="flex items-center gap-1.5">' +
                '<span class="font-mono font-bold text-slate-800 bg-slate-100 px-2 py-0.5 rounded border border-slate-200">' + escapeHTML(passcode) + '</span>' +
                '<button type="button" onclick="window.copyTextToClipboard(\'' + passcode + '\', \'Kode disalin!\')" class="btn-touch p-1 text-slate-400 hover:text-slate-700 text-xs" title="Salin">' +
                  '<i class="fa-regular fa-copy"></i>' +
                '</button>' +
                '<button type="button" onclick="window.openModalSetTeacherPasscode(\'' + guru.id + '\')" class="btn-touch p-1 text-emerald-600 hover:text-emerald-800 text-xs" title="Ubah Kode">' +
                  '<i class="fa-solid fa-pen-to-square"></i>' +
                '</button>' +
              '</div>' +
            '</td>' +
            '<td class="py-2.5 px-3">' + statusBadge + '</td>' +
            '<td class="py-2.5 px-3 text-right">' +
              '<div class="flex items-center justify-end gap-1.5">' +
                (guru.status !== 'Disetujui' ?
                  '<button type="button" onclick="window.updateTeacherStatus(\'' + guru.id + '\', \'Disetujui\')" class="btn-touch px-2 py-1 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-[10px] rounded-lg transition" title="Setujui">' +
                    '<i class="fa-solid fa-check"></i>' +
                  '</button>' : '') +
                (guru.status !== 'Ditolak' ?
                  '<button type="button" onclick="window.updateTeacherStatus(\'' + guru.id + '\', \'Ditolak\')" class="btn-touch px-2 py-1 bg-amber-500 hover:bg-amber-600 text-slate-900 font-bold text-[10px] rounded-lg transition" title="Tolak">' +
                    '<i class="fa-solid fa-ban"></i>' +
                  '</button>' : '') +
                '<button type="button" onclick="window.deleteTeacher(\'' + guru.id + '\')" class="btn-touch px-2 py-1 bg-rose-50 hover:bg-rose-100 text-rose-600 font-bold text-[10px] rounded-lg transition border border-rose-200" title="Hapus">' +
                  '<i class="fa-solid fa-trash-can"></i>' +
                '</button>' +
              '</div>' +
            '</td>' +
          '</tr>';
        });

        tbody.innerHTML = html;
        if (badgePending) badgePending.textContent = pendingCount;
        if (totalGuruEl) totalGuruEl.textContent = teachers.length;
      }

      function renderAdminAttendanceTable(logs) {
        var tbody = document.getElementById('adminReportTableBody');
        var totalEl = document.getElementById('totalPresensiCount');
        if (!tbody) return;

        if (totalEl) totalEl.textContent = logs.length;

        var html = '';
        logs.forEach(function (log) {
          var statusBadge = log.status === 'Tepat Waktu' ?
            '<span class="bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2 py-0.5 rounded-full">Tepat Waktu</span>' :
            '<span class="bg-rose-100 text-rose-800 text-[10px] font-bold px-2 py-0.5 rounded-full">Terlambat</span>';

          var tipeBadge = log.tipe === 'Datang' ?
            '<span class="bg-teal-50 text-teal-800 border border-teal-200 text-[10px] font-bold px-1.5 py-0.5 rounded">Datang</span>' :
            '<span class="bg-indigo-50 text-indigo-800 border border-indigo-200 text-[10px] font-bold px-1.5 py-0.5 rounded">Pulang</span>';

          html += '<tr class="hover:bg-slate-50 transition">' +
            '<td class="py-2.5 px-3 font-mono text-[11px] text-slate-600">' + escapeHTML(log.timeWITA || log.timestamp) + '</td>' +
            '<td class="py-2.5 px-3 font-bold text-slate-800">' + escapeHTML(log.nama) + '</td>' +
            '<td class="py-2.5 px-3 font-mono text-slate-500">' + escapeHTML(log.nip || '-') + '</td>' +
            '<td class="py-2.5 px-3">' + tipeBadge + '</td>' +
            '<td class="py-2.5 px-3">' + statusBadge + '</td>' +
            '<td class="py-2.5 px-3 font-mono text-slate-500">' + (log.distanceMeter ? log.distanceMeter + 'm' : '-') + '</td>' +
            '<td class="py-2.5 px-3 text-slate-600 italic">' + escapeHTML(log.catatan || '-') + '</td>' +
          '</tr>';
        });

        tbody.innerHTML = html;
      }

      function updateTeacherStatus(teacherId, newStatus) {
        var token = Auth.getToken();
        if (!token) return;

        showFullPageLoading('Memperbarui status guru...');
        gasRun('updateTeacherStatus', token, teacherId, newStatus).then(function (res) {
          hideFullPageLoading();
          if (handleSessionExpired(res)) return;
          if (res.success) {
            showToast('Status guru berhasil diubah menjadi: ' + newStatus, 'success');
            loadAdminData();
          } else {
            showToast('Gagal: ' + res.message, 'error');
          }
        }).catch(function (err) {
          hideFullPageLoading();
          showToast('Kesalahan server: ' + err.message, 'error');
        });
      }

      function deleteTeacher(teacherId) {
        openConfirmDialog(
          'Hapus Data Guru?',
          'Data guru dan autentikasi biometrik yang dihapus tidak dapat dipulihkan kembali.',
          'fa-solid fa-trash-can text-rose-600',
          'bg-rose-600 hover:bg-rose-700',
          function () {
            var token = Auth.getToken();
            if (!token) return;

            showFullPageLoading('Menghapus data guru...');
            gasRun('deleteTeacher', token, teacherId).then(function (res) {
              hideFullPageLoading();
              if (handleSessionExpired(res)) return;
              if (res.success) {
                showToast('Data guru berhasil dihapus!', 'success');
                loadAdminData();
              } else {
                showToast('Gagal: ' + res.message, 'error');
              }
            }).catch(function (err) {
              hideFullPageLoading();
              showToast('Kesalahan server: ' + err.message, 'error');
            });
          }
        );
      }

      function clearAllPresensiData() {
        openConfirmDialog(
          'Kosongkan Seluruh Riwayat?',
          'Seluruh catatan presensi guru di database akan dihapus permanen. Tindakan ini tidak dapat dibatalkan.',
          'fa-solid fa-triangle-exclamation text-rose-600',
          'bg-rose-600 hover:bg-rose-700',
          function () {
            var token = Auth.getToken();
            if (!token) return;

            showFullPageLoading('Mengosongkan data presensi...');
            gasRun('clearAllAttendance', token).then(function (res) {
              hideFullPageLoading();
              if (handleSessionExpired(res)) return;
              if (res.success) {
                showToast('Seluruh riwayat presensi berhasil dikosongkan.', 'success');
                loadAdminData();
                fetchInitialPublicData(false);
              } else {
                showToast('Gagal: ' + res.message, 'error');
              }
            }).catch(function (err) {
              hideFullPageLoading();
              showToast('Kesalahan server: ' + err.message, 'error');
            });
          }
        );
      }

      // Inisialisasi awal saat halaman dimuat
      window.onload = function () {
        Auth.restore();
        checkLoginState();
        startWITAClock();
        showPage('terminalPage');
      };

      // Ekspor fungsi publik ke window object
      window.navToPage = navToPage;
      window.showPage = showPage;
      window.showLoginPage = showLoginPage;
      window.backToTerminalView = backToTerminalView;
      window.handleLoginForm = handleLoginForm;
      window.logoutAdmin = logoutAdmin;
      window.setPresenceMode = setPresenceMode;
      window.openCameraAttendanceModal = openCameraAttendanceModal;
      window.closeCameraAttendanceModal = closeCameraAttendanceModal;
      window.openPasscodeAttendanceModal = openPasscodeAttendanceModal;
      window.closePasscodeAttendanceModal = closePasscodeAttendanceModal;
      window.toggleCameraFlip = toggleCameraFlip;
      window.triggerFaceCaptureAndMatch = triggerFaceCaptureAndMatch;
      window.switchToNameVerification = switchToNameVerification;
      window.submitVerifyTeacherPasscode = submitVerifyTeacherPasscode;
      window.proceedAttendanceFromPasscode = proceedAttendanceFromPasscode;
      window.openModalSetTeacherPasscode = openModalSetTeacherPasscode;
      window.generateRandomTeacherPasscode = generateRandomTeacherPasscode;
      window.saveTeacherPasscodeSubmit = saveTeacherPasscodeSubmit;
      window.confirmSaveAttendance = confirmSaveAttendance;
      window.closeModal = closeModal;
      window.copyTextToClipboard = copyTextToClipboard;
      window.openConfirmDialog = openConfirmDialog;
      window.closeConfirmDialog = closeConfirmDialog;
      window.executeConfirmCallback = executeConfirmCallback;
      window.refreshGeolocation = refreshGeolocation;
      window.fetchInitialPublicData = fetchInitialPublicData;
      window.filterTodayAttendanceList = filterTodayAttendanceList;
      window.fetchAttendancePublic = fetchAttendancePublic;
      window.filterAttendanceList = filterAttendanceList;
      window.exportAttendanceCSV = exportAttendanceCSV;
      window.openTaspenEnrollModal = openTaspenEnrollModal;
      window.closeTaspenEnrollModal = closeTaspenEnrollModal;
      window.toggleCameraFlipEnroll = toggleCameraFlipEnroll;
      window.captureCurrentPoseStep = captureCurrentPoseStep;
      window.resetEnrollmentSteps = resetEnrollmentSteps;
      window.handleRegisterFileUpload = handleRegisterFileUpload;
      window.handleRegisterGuru = handleRegisterGuru;
      window.generatePivotAttendanceTable = generatePivotAttendanceTable;
      window.printPivotLaporan = printPivotLaporan;
      window.exportPivotPDF = exportPivotPDF;
      window.exportPivotExcel = exportPivotExcel;
      window.switchAdminTab = switchAdminTab;
      window.loadAdminData = loadAdminData;
      window.updateTeacherStatus = updateTeacherStatus;
      window.deleteTeacher = deleteTeacher;
      window.clearAllPresensiData = clearAllPresensiData;
      window.updateRadiusKmLabel = updateRadiusKmLabel;
      window.saveGeofenceSettings = saveGeofenceSettings;
      window.saveTimeSettings = saveTimeSettings;
      window.useCurrentLocationAsSchoolCenter = useCurrentLocationAsSchoolCenter;
      window.handleUploadLogo = handleUploadLogo;
      window.saveSchoolProfileSubmit = saveSchoolProfileSubmit;
      window.updatePrintKopAndSignaturesUI = updatePrintKopAndSignaturesUI;

    })();
  </script>
