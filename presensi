      function handleUploadLogo(e, type) {
        var file = e.target.files[0];
        if (!file) return;

        var reader = new FileReader();
        reader.onload = function(evt) {
          var dataUrl = evt.target.result;
          if (type === 'logoDinas') {
            appSettings.logoDinas = dataUrl;
            var prev = document.getElementById('previewLogoDinas');
            if (prev) prev.src = dataUrl;
          } else if (type === 'logoSekolah') {
            appSettings.logoSekolah = dataUrl;
            var prev2 = document.getElementById('previewLogoSekolah');
            if (prev2) prev2.src = dataUrl;
          }
          updatePrintKopAndSignaturesUI();
          showToast('Logo berhasil diunggah. Klik "Simpan Identitas" untuk mempermanenkan.', 'info');
        };
        reader.readAsDataURL(file);
      }

