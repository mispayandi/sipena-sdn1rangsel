    <script>
    (function () {
      'use strict';

      function escapeHTML(str) {
        if (!str && str !== 0) return '';
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      function showFullPageLoading(text) {
        var el = document.getElementById('fullLoadingOverlay');
        var txt = document.getElementById('fullLoadingText');
        if (txt && text) txt.textContent = text;
        if (el) el.classList.remove('d-none');
      }

      function hideFullPageLoading() {
        var el = document.getElementById('fullLoadingOverlay');
        if (el) el.classList.add('d-none');
      }

      function showToast(message, type) {
        var container = document.getElementById('toastContainer');
        if (!container) return;

        var toast = document.createElement('div');
        toast.className = 'fade-in pointer-events-auto p-3.5 rounded-xl text-xs font-semibold shadow-xl flex items-center gap-2.5 border transition ' +
          (type === 'error' ? 'bg-rose-600 text-white border-rose-500' :
           type === 'warning' ? 'bg-amber-500 text-slate-900 border-amber-400' :
           'bg-emerald-600 text-white border-emerald-500');

        var icon = type === 'error' ? 'fa-circle-xmark' : type === 'warning' ? 'fa-triangle-exclamation' : 'fa-circle-check';
        toast.innerHTML = '<i class="fa-solid ' + icon + ' text-base"></i><span>' + escapeHTML(message) + '</span>';

        container.appendChild(toast);
        setTimeout(function () {
          toast.style.opacity = '0';
          toast.style.transform = 'translateY(-10px)';
          setTimeout(function () {
            if (toast.parentNode) toast.parentNode.removeChild(toast);
          }, 300);
        }, 3500);
      }

      function gasRun(funcName) {
        var args = Array.prototype.slice.call(arguments, 1);
        return new Promise(function (resolve, reject) {
          if (typeof google === 'undefined' || !google.script || !google.script.run) {
            reject(new Error('Koneksi Google Apps Script tidak tersedia.'));
            return;
          }
          var runner = google.script.run
            .withSuccessHandler(function (res) { resolve(res); })
            .withFailureHandler(function (err) { reject(err); });
          runner[funcName].apply(runner, args);
        });
      }

      var Auth = {
        token: null,
        user: null,
        getToken: function () {
          return this.token || sessionStorage.getItem('SDN1_RARANG_AUTH_TOKEN');
        },
        setSession: function (user, token) {
          this.user = user;
          this.token = token;
          try {
            sessionStorage.setItem('SDN1_RARANG_AUTH_TOKEN', token);
            sessionStorage.setItem('SDN1_RARANG_AUTH_USER', JSON.stringify(user));
          } catch(e) {}
        },
        clearSession: function () {
          this.user = null;
          this.token = null;
          try {
            sessionStorage.removeItem('SDN1_RARANG_AUTH_TOKEN');
            sessionStorage.removeItem('SDN1_RARANG_AUTH_USER');
          } catch(e) {}
        },
        restore: function () {
          var t = sessionStorage.getItem('SDN1_RARANG_AUTH_TOKEN');
          var u = sessionStorage.getItem('SDN1_RARANG_AUTH_USER');
          if (t && u) {
            this.token = t;
            try { this.user = JSON.parse(u); } catch(e) { this.user = null; }
          }
        }
      };

      function handleSessionExpired(res) {
        if (res && res.sessionExpired) {
          Auth.clearSession();
          showToast('Sesi administrator telah kedaluwarsa. Silakan login kembali.', 'warning');
          checkLoginState();
          showPage('terminalPage');
          return true;
        }
        return false;
      }

      var appSettings = {
        schoolName: 'SDN 1 RARANG SELATAN',
        schoolLat: -8.64720,
        schoolLng: 116.43850,
        radiusMeters: 100,
        enforceGeo: true,
        terminalActive: true,
        jamDatangToleransi: '07:15',
        jamPulang: '14:00'
      };

      var teachersList = [];
      var attendanceLogs = [];
      var currentPresenceMode = 'Datang';
      var activeCameraFacing = 'user';
      var mediaStream = null;
      var enrollMediaStream = null;
      var isStartingWebcam = false;
      var userGeoCoord = { lat: -8.64720, lng: 116.43850, distance: 15, inRange: true };
      var activeIdentifiedTeacher = null;
      var verifiedPasscodeTeacher = null;
      var selectedTeacherPasscodeId = null;
      var isSubmittingAttendance = false;

      function getOrCreateDeviceId() {
        var devId = localStorage.getItem('SDN1_RARANG_DEVICE_ID');
        if (!devId) {
          devId = 'dev_' + Math.random().toString(36).substring(2, 9) + Date.now().toString(36);
          localStorage.setItem('SDN1_RARANG_DEVICE_ID', devId);
        }
        return devId;
      }

      function getTodayDateString() {
        var now = new Date();
        var utc = now.getTime() + (now.getTimezoneOffset() * 60000);
        var wita = new Date(utc + (3600000 * 8));
        var y = wita.getFullYear();
        var m = String(wita.getMonth() + 1).padStart(2, '0');
        var d = String(wita.getDate()).padStart(2, '0');
        return y + '-' + m + '-' + d;
      }

      function checkDeviceLockState() {
        var banner = document.getElementById('deviceLockBanner');
        var lblTeacher = document.getElementById('lblLockedTeacherName');
        if (!banner) return;

        var lockedDataStr = localStorage.getItem('SDN1_RARANG_DEVICE_LOCK');
        if (!lockedDataStr) {
          banner.classList.add('d-none');
          return;
        }

        try {
          var lockedData = JSON.parse(lockedDataStr);
          var today = getTodayDateString();
          if (lockedData.date === today && lockedData.guruNama) {
            banner.classList.remove('d-none');
            if (lblTeacher) lblTeacher.textContent = lockedData.guruNama;
          } else {
            banner.classList.add('d-none');
          }
        } catch(e) {
          banner.classList.add('d-none');
        }
      }

      function setDeviceLockForTeacher(guruId, guruNama) {
        var today = getTodayDateString();
        var payload = { date: today, guruId: guruId, guruNama: guruNama };
        try {
          localStorage.setItem('SDN1_RARANG_DEVICE_LOCK', JSON.stringify(payload));
        } catch(e) {}
        checkDeviceLockState();
      }

      function setPresenceMode(mode) {
        currentPresenceMode = mode;
        var btnDatang = document.getElementById('btnModeDatang');
        var btnPulang = document.getElementById('btnModePulang');
        var cameraBadge = document.getElementById('cameraModalModeBadge');

        if (mode === 'Datang') {
          if (btnDatang) {
            btnDatang.className = 'btn-touch py-2 px-5 rounded-xl text-xs font-black transition flex items-center gap-2 bg-emerald-500 text-slate-950 shadow-md';
          }
          if (btnPulang) {
            btnPulang.className = 'btn-touch py-2 px-5 rounded-xl text-xs font-black transition flex items-center gap-2 text-emerald-200 hover:text-white';
          }
        } else {
          if (btnPulang) {
            btnPulang.className = 'btn-touch py-2 px-5 rounded-xl text-xs font-black transition flex items-center gap-2 bg-teal-400 text-slate-950 shadow-md';
          }
          if (btnDatang) {
            btnDatang.className = 'btn-touch py-2 px-5 rounded-xl text-xs font-black transition flex items-center gap-2 text-emerald-200 hover:text-white';
          }
        }
        if (cameraBadge) cameraBadge.textContent = mode;
        showToast('Mode presensi diatur: ' + mode, 'info');
      }

      function openCameraAttendanceModal() {
        var modal = document.getElementById('modalCameraAttendance');
        var cameraBadge = document.getElementById('cameraModalModeBadge');
        if (cameraBadge) cameraBadge.textContent = currentPresenceMode;
        if (modal) modal.classList.remove('d-none');
        startWebcam();
      }

      function closeCameraAttendanceModal() {
        var modal = document.getElementById('modalCameraAttendance');
        if (modal) modal.classList.add('d-none');
        stopWebcam();
      }

      function openPasscodeAttendanceModal() {
        var modal = document.getElementById('modalPasscodeAttendance');
        if (modal) modal.classList.remove('d-none');
        checkDeviceLockState();
        var inp = document.getElementById('inputKodeKunciGuru');
        if (inp) {
          setTimeout(function() { inp.focus(); }, 150);
        }
      }

      function closePasscodeAttendanceModal() {
        var modal = document.getElementById('modalPasscodeAttendance');
        if (modal) modal.classList.add('d-none');
      }

      function switchToNameVerification() {
        closeModal('modalError');
        closeCameraAttendanceModal();
        openPasscodeAttendanceModal();
        showToast('Beralih ke metode verifikasi Kode Kunci.', 'info');
      }

      function submitVerifyTeacherPasscode() {
        var inputCode = document.getElementById('inputKodeKunciGuru');
        var errBox = document.getElementById('passcodeErrorMsg');
        var errText = document.getElementById('passcodeErrorText');
        var resBox = document.getElementById('passcodeTeacherResultBox');

        var code = (inputCode ? inputCode.value : '').trim();
        if (!code) {
          showToast('Masukkan kode kunci guru terlebih dahulu!', 'warning');
          if (inputCode) inputCode.focus();
          return;
        }

        var devId = getOrCreateDeviceId();
        showFullPageLoading('Memverifikasi kode kunci guru...');

        gasRun('verifyTeacherPasscode', code, devId).then(function (res) {
          hideFullPageLoading();
          if (res.success && res.data) {
            verifiedPasscodeTeacher = res.data;
            verifiedPasscodeTeacher._alreadyDatang = res.alreadyDatang;
            verifiedPasscodeTeacher._alreadyPulang = res.alreadyPulang;

            if (errBox) errBox.classList.add('d-none');
            if (resBox) resBox.classList.remove('d-none');

            var imgPhoto = document.getElementById('resPasscodePhoto');
            var lblNama = document.getElementById('resPasscodeNama');
            var lblNIP = document.getElementById('resPasscodeNIP');
            var lblJabatan = document.getElementById('resPasscodeJabatan');
            var badgeDatang = document.getElementById('badgeTodayDatang');
            var badgePulang = document.getElementById('badgeTodayPulang');
            var btnLanjut = document.getElementById('btnLanjutAbsenPasscode');

            if (imgPhoto) imgPhoto.src = res.data.photo || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=200';
            if (lblNama) lblNama.textContent = res.data.nama;
